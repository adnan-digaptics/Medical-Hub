Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(php|phtml|phar|cgi|pl|shtml)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)\.(log|json|txt)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
